<!-- candy icon -->
<svg id="candy" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-candy-icon lucide-candy">
  <path class="wrapper" d="M10 7v10.9"/>
  <path class="wrapper" d="M14 6.1V17"/>
  <!--  top wrapper  -->
  <path class="wrapper1" d="M16 7V3a1 1 0 0 1 1.707-.707 2.5 2.5 0 0 0 2.152.717 1 1 0 0 1 1.131 1.131 2.5 2.5 0 0 0 .717 2.152A1 1 0 0 1 21 8h-4"/>
  <path class="wrapper1" d="M16.536 7.465a5 5 0 0 0-7.072 0l-2 2a5 5 0 0 0 0 7.07 5 5 0 0 0 7.072 0l2-2a5 5 0 0 0 0-7.07"/>
  <!--  bottom wrapper  -->
  <path class="wrapper1" d="M8 17v4a1 1 0 0 1-1.707.707 2.5 2.5 0 0 0-2.152-.717 1 1 0 0 1-1.131-1.131 2.5 2.5 0 0 0-.717-2.152A1 1 0 0 1 3 16h4"/>
</svg>


<!-- GSAP Scripting -->
<script>
    // import GSAP
    import gsap from 'gsap';

    // animate it
    gsap.from('#candy', {
        x: -200
    });

    // Hover animations
    const circle = document.querySelector('#candy');

    circle.addEventListener('mouseenter', () => {
        gsap.to('#candy', {
            scale: 1.2,
            transformOrigin: 'center',
            duration: 0.3,
            ease: 'power2.out'
        });
    });

    circle.addEventListener('mouseleave', () => {
        gsap.to('#candy', {
            scale: 1,
            transformOrigin: 'center',
            duration: 0.3,
            ease: 'power2.in'
        });
    });
    /* candy animation */
const candyTL = gsap.timeline();

// entrance
candyTL.from("#candy", {
  y: -500,
  rotation: -180,
  duration: 1.4,
  ease: "power3.out"
})

// settling
.to("#candy", {
  y: 10,
  duration: 0.25,
  yoyo: true,
  repeat: 1,
  ease: "sine.inOut"
})

// continuous spin 
.to("#candy", {
  rotation: "+=360",
  duration: 6,
  repeat: -1,
  ease: "none",
  transformOrigin: "center center"
}, 1.4);
</script>