<!-- Hexagon icon from Lucide -->

<!-- tv icon -->
<svg id="tv" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-tv-icon lucide-tv">
  <!--  antenna  -->
  <path stroke="grey" d="m17 2-5 5-5-5"/>
<!--  box  -->
  <rect width="20" height="15" x="2" y="7" rx="2"/>
</svg>

<!-- GSAP Scripting -->
<script>
    import gsap from 'gsap';

    gsap.from('#tv', {
        scale: 2,
        opacity: 0,
        transformOrigin: 'center',
        duration: 0.7,
        ease: 'elastic.out(1, 0.5)'
    });

    // Hover animations
    const hexagon = document.querySelector('#tv');

    hexagon.addEventListener('mouseenter', () => {
        gsap.to('#tv', {
            scale: 1.5,
            transformOrigin: 'center',
            duration: 0.4,
            ease: 'power2.out'
        });
    });

    hexagon.addEventListener('mouseleave', () => {
        gsap.to('#tv', {
            scale: 1,
            transformOrigin: 'center',
            duration: 0.4,
            ease: 'power2.in'
        });
    });

/* tv animation */
const tvTL = gsap.timeline();

tvTL.from("#tv", {
  x: 600,
  opacity: 0,
  duration: 1.2,
  ease: "power4.out"
})

// settle
.to("#tv", {
  x: -8,
  duration: 0.15,
  ease: "power1.out",
  yoyo: true,
  repeat: 1
})

// flicker
.to("#tv", {
  opacity: 0.3,
  duration: 0.08,
  repeat: 5,
  yoyo: true,
  ease: "none",
  delay: 0.2
})

// landing
.to("#tv", {
  opacity: 1,
  duration: 0.2
})

gsap.to("#tv", {
  scale: 1.2,
  duration: 2,
  repeat: -1,
  yoyo: true,
  ease: "sine.inOut",
  transformOrigin: "center center",
  delay: 2
});
</script>
