<!-- Diamond icon from Lucide -->


<!-- chair icon -->
<svg id="chair" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-armchair-icon lucide-armchair">
  <path  d="M19 9V6a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v3"/>
  <path d="M3 16a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0v1.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V11a2 2 0 0 0-4 0z"/>
  <path  d="M5 18v2"/>
  <path d="M19 18v2"/>
</svg>

<!-- GSAP Scripting -->
<script>
    import gsap from 'gsap';

    // Hover animations
    const diamond = document.querySelector('#chair');

    diamond.addEventListener('mouseenter', () => {
        gsap.to('#chair', {
            rotation: -35,
            transformOrigin: 'center',
            duration: 0.4,
            ease: 'power2.out'
        });
    });

    diamond.addEventListener('mouseleave', () => {
        gsap.to('#chair', {
            rotation: 0,
            transformOrigin: 'center',
            duration: 0.4,
            ease: 'power2.in'
        });
    });

/* chair animation */
const chairTL = gsap.timeline();

// entrance
chairTL.from("#chair", {
  y: 600,
  rotation: 8,
  duration: 1.2,
  ease: "power3.out"
})

// landing 
.to("#chair", {
  scaleY: 0.92,
  scaleX: 1.03,
  duration: 0.12,
  ease: "power1.out"
})

// settle 
.to("#chair", {
  scale: 1,
  duration: 0.5,
  ease: "elastic.out(1, 0.4)",
  repeat: 25,
})
</script>
