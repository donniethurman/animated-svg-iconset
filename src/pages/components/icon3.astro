<!-- Triangle icon from Lucide -->

<!-- popcorn icon -->
<svg id="popcorn" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-popcorn-icon lucide-popcorn">
  <!-- corn -->
  <path stroke="#F4C95D" d="M18 8a2 2 0 0 0 0-4 2 2 0 0 0-4 0 2 2 0 0 0-4 0 2 2 0 0 0-4 0 2 2 0 0 0 0 4"/>
  <!-- bucket -->
  <path class="bucket1" d="M10 22 9 8"/>
  <path class="bucket1" d="m14 22 1-14"/><path class="bucket1" d="M20 8c.5 0 .9.4.8 1l-2.6 12c-.1.5-.7 1-1.2 1H7c-.6 0-1.1-.4-1.2-1L3.2 9c-.1-.6.3-1 .8-1Z"/>
</svg>


<!-- GSAP Scripting -->
<script>
    import gsap from 'gsap';

    // Hover animations
    const triangle = document.querySelector('#popcorn');

    triangle.addEventListener('mouseenter', () => {
        gsap.to('#popcorn', {
            y: -4,
            duration: 0.3,
            ease: 'power2.out'
        });
    });

    triangle.addEventListener('mouseleave', () => {
        gsap.to('#popcorn', {
            y: 0,
            duration: 0.3,
            ease: 'power2.in'
        });
    });
    // popcorn
const popcornTL = gsap.timeline();

// entrance
popcornTL.from("#popcorn", {
  y: 500,
  rotation: -20,
  duration: 1.2,
  ease: "back.out(1.7)"
})

// settling
.to("#popcorn", {
  y: -10,
  duration: 0.2,
  yoyo: true,
  repeat: 1,
  ease: "power1.out"
})

// continuous shake
.to("#popcorn", {
  rotation: 4,
  y: -4,
  transformOrigin: "bottom center",
  duration: 0.2,
  repeat: -1,
  yoyo: true,
  ease: "sine.inOut"
});
</script>
