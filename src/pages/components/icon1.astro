<!-- Square icon from Lucide -->

<!-- moon -->
<svg id="cloud-moon" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cloud-moon-icon lucide-cloud-moon">
  <!-- cloud -->
  <path stroke="#1F3C4F" d="M13 16a3 3 0 0 1 0 6H7a5 5 0 1 1 4.9-6z" id="cloud"/>
  <!-- moon -->
  <path stroke="#F4C95D" d="M18.376 14.512a6 6 0 0 0 3.461-4.127c.148-.625-.659-.97-1.248-.714a4 4 0 0 1-5.259-5.26c.255-.589-.09-1.395-.716-1.248a6 6 0 0 0-4.594 5.36" id="moon"/>
</svg>

<!-- GSAP Scripting -->
<script>
    import gsap from 'gsap';

    gsap.from('#cloud-moon', {
        scale: 0,
        transformOrigin: 'center',
        duration: 0.6,
        ease: 'back.out(1.7)'
    });

    // Hover animations
    const square = document.querySelector('#cloud-moon');

    square.addEventListener('mouseenter', () => {
        gsap.to('#cloud-moon', {
            scale: 1.2,
            transformOrigin: 'center',
            duration: 0.3,
            ease: 'power2.out'
        });
    });

    square.addEventListener('mouseleave', () => {
        gsap.to('#cloud-moon', {
            scale: 1,
            transformOrigin: 'center',
            duration: 0.3,
            ease: 'power2.in'
        });
    });
    gsap.from("#cloud-moon", {
  x: -600,
  opacity: 0,
  duration: 1.5,
  ease: "power3.out"
});

const cloudTL = gsap.timeline({
  repeat: 1,
  yoyo: true
});

// cloud 
gsap.to("#cloud", {
  y: 2,
  duration: 2,
  repeat: -1,
  yoyo: true,
  ease: "sine.inOut"
});
</script>